# Salin file ini jadi .env dan isi kalau perlu. Semua opsional --
# tanpa ini pun backend jalan penuh dalam mode simulasi.

# Diisi SETELAH training_table.parquet / viirs_daily.parquet / grid_cells.geojson
# di-upload ke HuggingFace Dataset repo (huggingface-cli upload / push_to_hub).
HF_DATASET_REPO=

# Diisi SETELAH model (LightGBM/ConvLSTM/dst) di-upload ke HuggingFace Model repo.
HF_MODEL_REPO=

# Hanya perlu kalau repo di atas private.
HF_TOKEN=

# Opsional -- aktifkan mode LLM / RAG untuk AI Weekly Insight & Ask AI.
# Kosongkan untuk pakai mode template (tetap akurat, tanpa perlu API key).
OPENAI_API_KEY=

# Opsional -- jika pakai endpoint OpenAI-compatible selain api.openai.com.
OPENAI_BASE_URL=https://api.openai.com/v1

# Opsional -- kalau diisi, POST /api/admin/refresh-predictions butuh
# header X-Admin-Key yang cocok. WAJIB diisi sebelum deploy publik.
ADMIN_API_KEY=

# Origin frontend yang boleh memanggil API ini (pisahkan dengan koma).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
